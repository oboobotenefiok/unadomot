rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // HELPER FUNCTIONS
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isListingOwner() {
      return isAuthenticated() &&
             resource.data.landlordId == request.auth.uid;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidEmail(email) {
      return email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }

    function isValidPhone(phone) {
      return phone == null || phone.size() == 0 ||
             phone.matches('^(\\+234|0)[0-9]{10}$');
    }

    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Public read — needed for profile pages and landlord info
      allow read: if true;

      // Owners can write their own profile (with field restrictions)
      allow write: if isOwner(userId) &&
                    request.resource.data.keys().hasOnly([
                      'name', 'email', 'phone', 'bio',
                      'photoURL', 'userType', 'lastActive',
                      'replyRate', 'responseTime', 'verified',
                      'blockedUsers', 'authProvider', 'createdAt'
                    ]) &&
                    (!('email' in request.resource.data) ||
                     isValidEmail(request.resource.data.email)) &&
                    (!('phone' in request.resource.data) ||
                     isValidPhone(request.resource.data.phone));

      // Admins can update status fields (banning) and approve/reject verification
      allow update: if isAdmin() &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'bannedAt', 'bannedBy', 'banReason', 'verified']);

      allow delete: if isOwner(userId);

      // ============================================
      // FAVORITES SUBCOLLECTION
      // ============================================
      match /favorites/{listingId} {
        allow read, write, delete: if isOwner(userId);
      }

      // ============================================
      // VERIFICATION DOCUMENTS (SENSITIVE)
      // ============================================
      match /verification/{documentId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) &&
                      request.resource.data.keys().hasOnly([
                        'idType', 'idNumber', 'phoneNumber',
                        'submittedAt', 'status', 'rejectionReason'
                      ]);
        allow delete: if false;
      }
    }

    // ============================================
    // LISTINGS COLLECTION
    // ============================================
    match /listings/{listingId} {
      // Anyone can read available listings; owners can always read their own
      allow read: if resource.data.status == 'available' ||
                   (isAuthenticated() && resource.data.landlordId == request.auth.uid) ||
                   isAdmin();

      // Create — must be authenticated, landlordId must equal caller's UID
      allow create: if isAuthenticated() &&
                     request.resource.data.keys().hasOnly([
                       'title', 'description', 'price', 'address',
                       'state', 'lga', 'agentToggle', 'landlordId',
                       'status', 'createdAt', 'expiryDate', 'viewCount',
                       'images', 'bedrooms', 'bathrooms', 'size',
                       'propertyType', 'furnishing', 'amenities'
                     ]) &&
                     request.resource.data.landlordId == request.auth.uid &&
                     request.resource.data.price > 0 &&
                     request.resource.data.status == 'available';

      // Owner update — listing owner can edit their own listing fields
      // FIX: Added 'deletedAt' to the allowed keys so soft-delete works
      allow update: if isListingOwner() &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly([
                         'title', 'description', 'price', 'address',
                         'state', 'lga', 'agentToggle', 'status',
                         'expiryDate', 'viewCount', 'images',
                         'bedrooms', 'bathrooms', 'size',
                         'propertyType', 'furnishing', 'amenities',
                         'deletedAt', 'updatedAt'
                       ]) &&
                     (!('price' in request.resource.data) ||
                      request.resource.data.price > 0);

      // Admin update — admins can set status to 'removed_by_admin'
      allow update: if isAdmin() &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'removedAt', 'removedBy', 'removedReason']);

      allow delete: if isListingOwner() || isAdmin();
    }

    // ============================================
    // REPORTS COLLECTION
    // ============================================
    match /reports/{reportId} {
      // Any authenticated user can file a report
      allow create: if isAuthenticated() &&
                     request.resource.data.reportedBy == request.auth.uid &&
                     request.resource.data.keys().hasOnly([
                       'targetId', 'targetType', 'reportedBy',
                       'reason', 'description', 'status', 'createdAt'
                     ]) &&
                     request.resource.data.status == 'pending' &&
                     request.resource.data.targetType in ['listing', 'user'];

      // Only admins can read and action reports
      allow read: if isAdmin();
      allow update: if isAdmin() &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'adminNote']);

      allow delete: if false;
    }

    // ============================================
    // CHATS COLLECTION
    // ============================================
    match /chats/{chatId} {
      allow read: if isAuthenticated() &&
                   request.auth.uid in resource.data.participants;

      allow create: if isAuthenticated() &&
                     request.resource.data.keys().hasOnly([
                       'participants', 'listingId', 'createdAt',
                       'lastMessage', 'lastMessageTime', 'lastSenderId',
                       'participantInfo'
                     ]) &&
                     request.auth.uid in request.resource.data.participants &&
                     request.resource.data.participants.size() == 2;

      allow update: if isAuthenticated() &&
                     request.auth.uid in resource.data.participants &&
                     request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastMessage', 'lastMessageTime',
                                'lastSenderId', 'participantInfo', 'lastRead']);

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
                     get(/databases/$(database)/documents/chats/$(chatId)).data
                       .participants.hasAny([request.auth.uid]);

        allow create: if isAuthenticated() &&
                       get(/databases/$(database)/documents/chats/$(chatId)).data
                         .participants.hasAny([request.auth.uid]) &&
                       request.resource.data.keys().hasOnly([
                         'senderId', 'text', 'createdAt', 'read', 'type'
                       ]) &&
                       request.resource.data.senderId == request.auth.uid &&
                       request.resource.data.text.size() > 0 &&
                       request.resource.data.text.size() < 5000;

        allow update: if isAuthenticated() &&
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['read']) &&
                       request.resource.data.read == true;

        allow delete: if false;
      }
    }

    // ============================================
    // CHECKOUT NOTICES COLLECTION
    // ============================================
    match /checkoutNotices/{noticeId} {
      allow read: if isAuthenticated() &&
                   (resource.data.tenantId == request.auth.uid ||
                    (exists(/databases/$(database)/documents/listings/$(resource.data.listingId)) &&
                     get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.landlordId == request.auth.uid));

      allow create: if isAuthenticated() &&
                     request.resource.data.keys().hasOnly([
                       'propertyAddress', 'moveOutDate', 'reason',
                       'tenantId', 'verified', 'createdAt', 'listingId'
                     ]) &&
                     request.resource.data.tenantId == request.auth.uid &&
                     request.resource.data.moveOutDate > request.time;

      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.tenantId == request.auth.uid;
    }

    // ============================================
    // ADMINS COLLECTION
    // ============================================
    match /admins/{adminId} {
      // Only existing admins can read this collection (bootstrap first admin via Firebase console)
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
