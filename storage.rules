  rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if user owns the file
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Listings images - anyone can read
    match /listings/{fileName} {
      allow read: if true;
      
      // Only authenticated users can upload
      allow write: if isAuthenticated() && 
                    // File size < 5MB
                    request.resource.size < 5 * 1024 * 1024 &&
                    // Must be image
                    request.resource.contentType.matches('image/.*');
    }
    
    // User avatars - private
    match /users/{userId}/{fileName} {
      allow read: if true;  // Avatars can be public
      allow write: if isOwner(userId) &&
                    request.resource.size < 2 * 1024 * 1024 &&
                    request.resource.contentType.matches('image/.*');
    }
    
    // Verification documents - extremely restricted
    match /verification/{userId}/{fileName} {
      allow read: if isOwner(userId);  // Only owner can view
      allow write: if isOwner(userId) &&
                    request.resource.size < 10 * 1024 * 1024 &&
                    request.resource.contentType.matches('application/(pdf|jpg|jpeg|png)');
    }
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}